Project DESL {
  database_type: "GenericSQL"
  Note: "Generated from markdown files in data-model."
}

Table Event {
  Note: "Event log used for change tracking and event-driven orchestration."
  event_id bigint [pk, increment, note: "Unique event identifier."]
  event_dt timestamp [note: "Event timestamp including milliseconds."]
  event_type varchar(255) [note: "Type of event (Write, Read, InternalProcess, SchemaChange)."]
  event_lifecycle varchar(255) [note: "Event lifecycle (Start, EndSuccessful, EndFailed, InProgress)."]
  obj_id bigint [ref: > Obj.obj_id, note: "FK to a known object from Obj (when found)."]
  obj_type varchar(255) [note: "Type of related object."]
  obj_name varchar(255) [note: "Name of related object."]
  obj_path varchar(255) [note: "Path of related object."]
  container_type varchar(255) [note: "Storage/system technology type."]
  container_name varchar(255) [note: "Storage/system instance name."]
  increment_identifier varchar(255) [note: "Increment marker for partitioned/incremental events."]
  record_count bigint [note: "Record count in event payload."]
  progress_indicator smallint [note: "Progress value for in-progress events."]
}

Table Obj {
  Note: "Stores data objects and data containers and their hierarchical relationship."
  obj_id bigint [pk, increment, note: "Surrogate object identifier."]
  obj_type varchar(255) [note: "Object class (table, file, schema, database, folder)."]
  obj_name varchar(255) [note: "Logical object name."]
  obj_path varchar(255) [note: "Qualified object location/path."]
  parent_obj_id bigint [note: "FK to parent object."]
}

Table Prop {
  Note: "Property definition for adding flexible meta data to objects."
  prop_id bigint [pk, increment, note: "Surrogate key for prop definition."]
  prop_name varchar(255) [note: "Unique prop name."]
  data_type varchar(255) [note: "Property value type."]
  root_obj_type varchar(255) [note: "Root object type where property inheritance starts."]
  levels_deep smallint [note: "Default inheritance depth for prop propagation. -1 for all levels, 0 for no inheritance."]
}

Table ObjProp {
  Note: "Link table assigning properties to objects, including inheritance and overrides."
  obj_prop_id bigint [pk, increment, note: "Surrogate key for assignment row."]
  obj_id bigint [ref: > Obj.obj_id, note: "Target object receiving the prop."]
  prop_id bigint [ref: > Prop.prop_id, note: "Referenced prop definition."]
  prop_value varchar(255) [note: "Effective prop value for the object."]
  levels_deep smallint [note: "Inheritance depth for prop propagation. -1 for all levels, 0 for no inheritance."]
}

Table ObjSchema {
  Note: "Schema metadata table for columns belonging to data objects."
  obj_schema_id bigint [pk, increment, note: "Surrogate key for schema metadata row."]
  obj_id bigint [ref: > Obj.obj_id, note: "Reference to object whose schema is described."]
  ordinal_position int [note: "Source column order."]
  column_name varchar(255) [note: "Name of source column."]
  data_type varchar(255) [note: "Source column type."]
  is_nullable boolean [note: "Whether source column allows nulls."]
  is_pk boolean [note: "Whether source column participates in primary key."]
}

Table ControllerRule {
  Note: "Routing rules that map incoming events to executable task templates."
  controller_rule_id bigint [pk, increment, note: "Surrogate key for rule row."]
  rule_name varchar(255) [note: "Rule name."]
  filter_event_type varchar(255) [note: "Optional filter for event type."]
  filter_event_status varchar(255) [note: "Optional filter for event status."]
  filter_obj_type varchar(255) [note: "Optional filter for object type."]
  filter_obj_name varchar(255) [note: "Optional filter for object name."]
  filter_obj_path varchar(255) [note: "Optional filter for object path."]
  filter_container_type varchar(255) [note: "Optional filter for container type."]
  filter_container_name varchar(255) [note: "Optional filter for container name."]
  task_template_id bigint [ref: > TaskTemplate.task_template_id, note: "Task template to run on match."]
  priority int [note: "Rule processing priority."]
  is_active boolean [note: "Active-state flag."]
}

Table DataContract {
  Note: "Contract metadata between data owner and data consumer for source ingestion."
  data_contract_id bigint [pk, increment, note: "Surrogate key for contract row."]
  contract_name varchar(255) [note: "Human-readable contract name."]
  source_obj_id bigint [ref: > Obj.obj_id, note: "Source object governed by the contract."]
  data_owner varchar(255) [note: "Owner responsible for granting access."]
  data_consumer varchar(255) [note: "Consumer allowed to use the data."]
  allowed_purpose varchar(255) [note: "Allowed business purpose for usage."]
  delivery_window_start time [note: "Allowed delivery/extraction time window start time."]
  delivery_window_end time [note: "Allowed delivery/extraction time window end time."]
  allowed_frequency varchar(255) [note: "Allowed extraction frequency. (Always,Daily, Weekly, Monthly, WorkingDays, NonWorkingDays or days of the week in ISO-style numbers (1=Mon … 7=Sun), e.g.:1,2,3,5 → Monday, Tuesday, Wednesday, Friday"]
  active_from_dt timestamp [note: "Contract start timestamp."]
  active_to_dt timestamp [note: "Contract end timestamp."]
  is_active boolean [note: "Active-state flag."]
}


Table Queue {
  Note: "Execution queue table for tasks created from incoming events."
  queue_id bigint [pk, increment, note: "Surrogate key for queued task row."]
  source_event_id bigint [ref: > Event.event_id, note: "Event that created the task."]
  task_template_id bigint [ref: > TaskTemplate.task_template_id, note: "Template executed by this task."]
  task_status varchar(255) [note: "Current execution state."]
  priority int [note: "Queue priority used by scheduler."]
  expected_capacity int [note: "Capacity units consumed by task."]
  late_time_seconds int [note: "Delay between expected and actual arrival."]
  queued_dt timestamp [note: "Time task entered queue."]
  started_dt timestamp [note: "Time execution started."]
  finished_dt timestamp [note: "Time execution finished."]
  retry_count int [note: "Number of retries performed."]
  error_message text [note: "Last error details."]
}

Table TaskTemplate {
  Note: "Reusable orchestration task template definitions for ingestion execution."
  task_template_id bigint [pk, increment, note: "Surrogate key for template row."]
  task_template_name varchar(255) [note: "Template name."]
  interface_type varchar(255) [note: "Interface/protocol class used for extraction/loading."]
  task_code varchar(255) [note: "Executable task logic or reference."]
  retry_max_attempts int [note: "Maximum retry attempts."]
  retry_backoff_seconds int [note: "Delay between retries in seconds."]
  is_active boolean [note: "Active-state flag for template usage."]
}
