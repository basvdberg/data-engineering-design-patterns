#!/usr/bin/env bash
set -euo pipefail

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File "scripts/update-markdown-toc.ps1" -StagedOnly
elif command -v powershell >/dev/null 2>&1; then
  powershell -NoProfile -ExecutionPolicy Bypass -File "scripts/update-markdown-toc.ps1" -StagedOnly
else
  echo "PowerShell not found. Skipping markdown TOC update."
  exit 0
fi

git add -A -- '*.md'
