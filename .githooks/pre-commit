#!/bin/sh
# Run repository pre-commit checks (Markdown docs, naming, prompts).
set -e

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

PYTHON=""
for candidate in python3 python py; do
  if command -v "$candidate" >/dev/null 2>&1; then
    PYTHON="$candidate"
    break
  fi
done

if [ -z "$PYTHON" ]; then
  echo "pre-commit: python not found" >&2
  exit 1
fi

"$PYTHON" scripts/pre-commit.py
