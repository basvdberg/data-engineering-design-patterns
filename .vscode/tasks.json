{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Generate DESL DBML",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/generate-dbml.ps1",
        "-DataModelPath",
        "${workspaceFolder}/data model",
        "-OutFile",
        "${workspaceFolder}/build/desl.schema.dbml"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Generate + Lint DESL DBML",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& \"${workspaceFolder}/scripts/generate-dbml.ps1\" -DataModelPath \"${workspaceFolder}/data model\" -OutFile \"${workspaceFolder}/build/desl.schema.dbml\"; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; & \"${workspaceFolder}/scripts/lint-dbml.ps1\" -Path \"${workspaceFolder}/build/desl.schema.dbml\""
      ],
      "problemMatcher": []
    }
  ]
}
