{
  "name": "KNMI WFS daily climate observations",
  "notes": "INSPIRE WFS 2.0 service from KNMI (Koninklijk Nederlands Meteorologisch Instituut). Exposes controlled climatological daily data from 33 automatic weather stations across the Netherlands. Measurements include air temperature, recorded in tenths of degrees Celsius.",
  "classifications": [
    { "classification": "source:knmi" },
    { "classification": "protocol:wfs_v2" }
  ],
  "extensions": [
    { "key": "default_output_format", "value": "application/gml+xml; version=3.2" },
    { "key": "default_count", "value": "1000" }
  ],
  "dataObjectMappings": [
    {
      "id": "knmi-daggegevens-temperature",
      "name": "KNMI daily temperature observations to bronze landing",
      "enabled": true,
      "classifications": [
        { "classification": "interface_type:wfs_v2" },
        { "classification": "trigger:source_change" }
      ],
      "extensions": [
        { "key": "wfs_type_name", "value": "omso:PointTimeSeriesObservation" },
        { "key": "wfs_output_format", "value": "application/gml+xml; version=3.2" },
        { "key": "wfs_page_size", "value": "5" },
        { "key": "gml_parser", "value": "timeseries_observations" },
        { "key": "landing_path_template", "value": "./adl/Data/bronze/knmi/{dataset}/{table}/{date}.parquet" }
      ],
      "sourceDataObjects": [
        {
          "name": "PointTimeSeriesObservation",
          "dataConnection": {
            "name": "knmi-wfs-daggegevens",
            "extensions": [
              { "key": "base_url", "value": "https://haleconnect.com/ows/services/org.874.cb9ca55e-f4e7-4bd8-a02e-75d528e22118_wfs/org.874.794fa9da-8bf0-4053-83d8-1174f2317dcb" },
              { "key": "protocol", "value": "WFS" },
              { "key": "version", "value": "2.0.0" }
            ]
          }
        }
      ],
      "targetDataObject": {
        "name": "daggegevens-temperature",
        "dataConnection": {
          "name": "bronze-landing",
          "extensions": [
            { "key": "path", "value": "./data/bronze/knmi/daggegevens-temperature" }
          ]
        }
      }
    }
  ]
}
